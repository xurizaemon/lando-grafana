    },

    // Empty file - has no log entries
    {
      __path__ = "/app/tmp/ingest/idora1-islandora-fits.log",
      container_name = "idora1",
      service_name = "fits",
      log_time_format = "iso_ish",
      log_type = "application",
    },

    // Empty file - has no log entries
    {
      __path__ = "/app/tmp/ingest/idora1-islandora-gemini.log",
      container_name = "idora1",
      service_name = "gemini",
      log_time_format = "iso_ish",
      log_type = "application",
    },

    // Empty file - has no log entries
    {
      __path__ = "/app/tmp/ingest/idora1-islandora-homarus.log",
      container_name = "idora1",
      service_name = "homarus",
      log_time_format = "iso_ish",
      log_type = "application",
    },

    // Empty file - has no log entries
    {
      __path__ = "/app/tmp/ingest/idora1-islandora-houdini.log",
      container_name = "idora1",
      service_name = "houdini",
      log_time_format = "iso_ish",
      log_type = "application",
    },

    // [2026-04-23T12:45:22.490420+12:00] (RFC3339 with microseconds)
