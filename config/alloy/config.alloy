      __path__ = "/app/tmp/ingest/idora1-islandora-milliner.log",
      container_name = "idora1",
      service_name = "milliner",
      log_time_format = "rfc3339_micro",
      log_type = "application",
    },

    // 2026/04/23 17:36:44
    {
      __path__ = "/app/tmp/ingest/idora1-karaf-wrapper.log",
      container_name = "idora1",
      service_name = "karaf",
